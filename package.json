{
  "name": "nomad-mvp-monorepo",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.22.1 <23"
  },
  "scripts": {
    "ci:types": "pnpm -F nomad-types run generate",
    "ci:build": "pnpm -r build",
    "ci:lint": "node scripts/check-code-quality.mjs",
    "ci:mobile": "pnpm -F nomad-mobile test",
    "ci:handoff": "node scripts/check-handoff.mjs",
    "ci:home-library": "pnpm -F nomad-server run test:home-library",
    "ci:planner": "pnpm -F nomad-server run test:planner",
    "ci:settings": "pnpm -F nomad-server run test:settings",
    "ci:start-server": "node apps/server/dist/apps/server/src/index.js",
    "ci:auth": "pnpm -F nomad-server run test:auth",
    "ci:probe": "tsx scripts/synthetic-probe.ts",
    "ci:sse": "tsx scripts/sse-assert.ts",
    "ci:import-measurements": "node --import tsx --test scripts/measurements/import-report.test.mts && tsc -p scripts/measurements/tsconfig.json --noEmit",
    "ci:auth-measurements": "node --import tsx --test scripts/measurements/auth-report.test.mts scripts/measurements/auth-harness-boundaries.test.mts && tsc -p scripts/measurements/tsconfig.json --noEmit",
    "ci:auth-measurements:negative": "node --import tsx scripts/measurements/check-auth-guards.mts",
    "measure:auth": "node --import tsx scripts/measurements/run-auth.mts",
    "measure:auth-report": "node --import tsx scripts/measurements/auth-report.mts",
    "measure:import-dock": "node --import tsx scripts/measurements/run-import-dock.mts",
    "measure:import-report": "node --import tsx scripts/measurements/import-report.mts",
    "dev:homelab": "VITE_API_BASE_URL=http://localhost:43104 pnpm -F nomad-mobile dev --host localhost --port 5173 --strictPort",
    "ci:lint:negative": "node --test scripts/check-code-quality.test.mjs",
    "ci:workbench": "pnpm -F nomad-mobile run typecheck:workbench && pnpm -F nomad-mobile run test:workbench:network && pnpm -F nomad-mobile run build:storybook && pnpm -F nomad-mobile run test:workbench",
    "ci:workbench:negative": "node apps/mobile/scripts/check-workbench-counterexamples.mjs",
    "ci:workbench:isolation": "node apps/mobile/scripts/check-workbench-isolation.mjs && node --test apps/mobile/scripts/check-workbench-isolation.test.mjs && node apps/mobile/scripts/probe-workbench-runtime.mjs",
    "ci:browser": "pnpm -F nomad-mobile run typecheck:browser && NOMAD_BROWSER_RUN_KIND=suite pnpm -F nomad-mobile run test:browser && node apps/mobile/scripts/check-browser-results.mjs",
    "ci:browser:negative": "node apps/mobile/scripts/check-browser-network-guards.mjs && node apps/mobile/scripts/check-browser-flow-guards.mjs && node apps/mobile/scripts/check-browser-validation-guards.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/eventsource": "1.1.15",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eventsource": "^2.0.2",
    "globals": "17.12.0",
    "js-yaml": "4.1.0",
    "node-fetch": "^3.3.2",
    "tsx": "^4.16.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.0.2"
  },
  "packageManager": "pnpm@11.7.0"
}
