[Unit]
Description=Nomad phone HTTPS gateway backend
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=nomad
Group=nomad
WorkingDirectory=/opt/nomad-mvp/phone/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/nomad-mvp/development/objects.env
ExecStart=/usr/local/bin/node --env-file=/etc/nomad-mvp/phone/runtime.env --env-file=/etc/nomad-mvp/development/providers.env /opt/nomad-mvp/phone/current/apps/server/dist/apps/server/src/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/nomad-mvp/phone /home/nomad/.config /home/nomad/.cache

[Install]
WantedBy=multi-user.target
