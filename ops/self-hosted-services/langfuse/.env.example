# Provisioning only: pass to the official Langfuse Docker Compose release.
# Do not load into the Nomad application. Fill secrets and URLs before starting.
COMPOSE_PROJECT_NAME=nomad-langfuse
NEXTAUTH_URL=
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
TELEMETRY_ENABLED=false

# Dedicated observability database/cache; never reuse the Nomad business database.
POSTGRES_USER=langfuse
POSTGRES_DB=langfuse
POSTGRES_PASSWORD=
DATABASE_URL=
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=
CLICKHOUSE_CLUSTER_ENABLED=false
REDIS_AUTH=

# Local MinIO for Langfuse, independent of the deferred Alibaba OSS/CDN setup.
MINIO_ROOT_USER=nomad-langfuse
MINIO_ROOT_PASSWORD=
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=nomad-langfuse
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=nomad-langfuse
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=
# Must be reachable by the browser; fill after assigning the homelab host.
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=
LANGFUSE_S3_MEDIA_UPLOAD_INTERNAL_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false

# These resources and keys become usable only after successful initialization.
LANGFUSE_INIT_ORG_ID=nomad
LANGFUSE_INIT_ORG_NAME=Nomad
LANGFUSE_INIT_PROJECT_ID=nomad-staging
LANGFUSE_INIT_PROJECT_NAME=Nomad Staging
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=Nomad Admin
LANGFUSE_INIT_USER_PASSWORD=
