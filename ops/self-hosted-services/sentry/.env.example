# Overlay these values onto the .env shipped with a pinned Sentry release.
# This is not a replacement for the upstream image/version configuration.
COMPOSE_PROJECT_NAME=nomad-sentry
COMPOSE_PROFILES=feature-complete
SENTRY_BIND=127.0.0.1:19000
SENTRY_EVENT_RETENTION_DAYS=30
LAUNCHPAD_RPC_SHARED_SECRET=
# SENTRY_DSN is issued when the Nomad project is created; do not invent it.
