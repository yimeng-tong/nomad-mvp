{
  "name": "nomad-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "TMPDIR=/tmp vitest run && node --import tsx --test scripts/native-config-proof.test.mjs",
    "native:sync": "node scripts/sync-native-project.mjs",
    "native:preflight": "node --import tsx scripts/native-preflight.mjs",
    "native:verify": "node --import tsx scripts/verify-native-project.mjs",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -h 127.0.0.1 -p 6006 --no-open",
    "build:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build --disable-telemetry",
    "typecheck:workbench": "tsc -p tsconfig.workbench.json --noEmit",
    "test:workbench": "STORYBOOK_DISABLE_TELEMETRY=1 vitest run --config vitest.storybook.config.ts",
    "test:workbench:network": "vitest run --config vitest.workbench-node.config.ts",
    "typecheck:browser": "tsc -p tsconfig.e2e.json --noEmit",
    "test:browser": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "8.0.5",
    "@nomad/native-auth": "workspace:*",
    "nomad-types": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/browser-playwright": "4.1.11",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.3",
    "playwright": "1.63.0",
    "storybook": "10.6.0",
    "vite": "8.0.16",
    "vitest": "4.1.11"
  }
}
