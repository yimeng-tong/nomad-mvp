[Unit]
Description=Nomad MVP API
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=nomad
Group=nomad
WorkingDirectory=/opt/nomad-mvp/current
EnvironmentFile=/etc/nomad-mvp/nomad.env
Environment=CI=true
ExecStart=/usr/local/bin/node /opt/nomad-mvp/current/apps/server/dist/apps/server/src/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/nomad-mvp /home/nomad/.config /home/nomad/.cache

[Install]
WantedBy=multi-user.target
