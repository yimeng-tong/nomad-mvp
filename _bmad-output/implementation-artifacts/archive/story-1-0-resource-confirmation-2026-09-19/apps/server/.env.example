# Story 1.0 T0 preflight template. Resource credentials are intentionally empty.
# The new validator is not yet wired into the application bootstrap.
# Passing preflight does not mean authentication is implemented or production-ready.
# Never overwrite an existing .env or commit real configuration/secrets.

AUTH_RUNTIME_MODE=production
# Current user selection: Alibaba PNVS SMS authentication + PNVS graphic H5.
AUTH_PROVIDER=aliyun-pnvs
AUTH_PUBLIC_ORIGIN=
# Optional separate API origin; defaults to AUTH_PUBLIC_ORIGIN.
AUTH_API_ORIGIN=
# Exact comma-separated origins; defaults to AUTH_PUBLIC_ORIGIN. No wildcard.
AUTH_TRUSTED_ORIGINS=
# Explicit trusted proxy addresses/CIDRs only; empty means no proxy trust.
AUTH_TRUSTED_PROXY_CIDRS=

DATABASE_URL=
REDIS_URL=
AUTH_LOGIN_METHODS=phone
AUTH_TEST_ADAPTER_ENABLED=false
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_TTL_SEC=2592000

# Alibaba PNVS SMS authentication (Dypnsapi; not Dysms SendSms).
# Use scoped application RAM credentials or STS; do not deploy the admin env.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
ALIYUN_PNVS_SIGN_NAME=
# System login/register template. Verify that it is available for the account.
ALIYUN_PNVS_TEMPLATE_CODE=100001
ALIYUN_PNVS_TEMPLATE_PARAM='{"code":"##code##","min":"5"}'
# Optional; absent means the provider's default scheme. Send/check must match.
ALIYUN_PNVS_SCHEME_NAME=

# Required only for approved social methods added to AUTH_LOGIN_METHODS.
# Configure the actual verified host/provider path; do not infer App/tenant rights.
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_REDIRECT_URI=
AUTH_APPLE_CONNECTION=
AUTH_WECHAT_CONNECTION=

AUTH_CAPTCHA_MODE=risk
# PNVS graphic H5 scheme has its own appId/appKey (not cloud AK or Captcha 2.0).
# Only appId may reach the browser. appKey stays on the server.
ALIYUN_PNVS_CAPTCHA_APP_ID=
ALIYUN_PNVS_CAPTCHA_APP_KEY=

# U-Link/U-App host, privacy and actual queryable attribution must be verified separately.
# No alternative product is silently selected by this template.
UAPP_APP_KEY=
# Registered U-App platform: android or ios, if known. A key does not add a native host.
UAPP_PLATFORM=
# Isolated fixture profiles must explicitly use AUTH_RUNTIME_MODE=test (or local),
# AUTH_PROVIDER=fixture, AUTH_TEST_ADAPTER_ENABLED=true and an appropriate local origin.
# Fixture profiles are not production resources and cannot satisfy real-service acceptance.
